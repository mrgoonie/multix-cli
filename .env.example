# ===== Provider API keys =====
GEMINI_API_KEY=
# Optional extra Gemini keys, tried in numeric order when a key hits a 429 / RESOURCE_EXHAUSTED quota
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
LEONARDO_API_KEY=
BYTEPLUS_API_KEY=
# Fallback for BYTEPLUS_API_KEY (Volcengine ARK shared name)
ARK_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
ATLASCLOUD_API_KEY=

# ===== Output / CLI behavior =====
# Override default output dir (./multix-output)
MULTIX_OUTPUT_DIR=
# Set to "1" to disable loading ~/.multix/.env
MULTIX_DISABLE_HOME_ENV=
# Set to "1" to disable ANSI colors
NO_COLOR=

# ===== Gemini model overrides =====
# The default text-output model for analyze, transcribe, extract, and doc convert is gemini-3.6-flash.
GEMINI_MODEL=
MULTIMODAL_MODEL=
IMAGE_GEN_MODEL=
GEMINI_IMAGE_GEN_MODEL=
VIDEO_GEN_MODEL=
GEMINI_TTS_MODEL=
TTS_MODEL=

# ===== OpenRouter model overrides =====
OPENROUTER_IMAGE_MODEL=
OPENROUTER_VIDEO_MODEL=
# Comma-separated fallback model ids
OPENROUTER_FALLBACK_MODELS=

# ===== OpenAI model overrides =====
OPENAI_IMAGE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_STT_MODEL=

# ===== MiniMax model overrides =====
MINIMAX_IMAGE_MODEL=
MINIMAX_VIDEO_MODEL=
MINIMAX_SPEECH_MODEL=
MINIMAX_MUSIC_MODEL=

# ===== Leonardo model overrides =====
LEONARDO_DEFAULT_MODEL=
LEONARDO_VIDEO_MODEL=

# ===== BytePlus model overrides =====
BYTEPLUS_IMAGE_MODEL=
BYTEPLUS_VIDEO_MODEL=
BYTEPLUS_VIDEO_PARAMS_MODE=

# ===== fal.ai model overrides =====
FAL_BASE_URL=
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=
FAL_VIDEO_IMAGE_MODEL=
# Also read legacy AgentKit .claude env files (off by default)
MULTIX_LEGACY_CLAUDE_ENV=

# ===== Atlas Cloud overrides =====
# Media API base (default https://api.atlascloud.ai/api/v1); for testing/mocks only
ATLASCLOUD_BASE_URL=
ATLASCLOUD_IMAGE_MODEL=
ATLASCLOUD_IMAGE_EDIT_MODEL=
ATLASCLOUD_VIDEO_MODEL=
ATLASCLOUD_IMAGE_TO_VIDEO_MODEL=
ATLASCLOUD_TTS_MODEL=
ATLASCLOUD_STT_MODEL=
ATLASCLOUD_TEXT_TO_3D_MODEL=
ATLASCLOUD_IMAGE_TO_3D_MODEL=
# Max size in MB for local files uploaded via --ref/--audio/upload (default 200)
ATLASCLOUD_MAX_UPLOAD_MB=
