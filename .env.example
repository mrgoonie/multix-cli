# A project .env may only set variables multix reads: the ones below (except the
# MULTIX_ALLOW_PROJECT_BASE_URL and MULTIX_LEGACY_CLAUDE_ENV opt-ins), the other
# provider settings in the environment reference and GEMINI_API_KEY_<n>. Other
# names, e.g. NODE_OPTIONS or HTTPS_PROXY, are ignored with a warning; set them in
# your shell or ~/.multix/.env instead.

# ===== Provider API keys =====
GEMINI_API_KEY=
# Optional extra Gemini keys, tried in numeric order when a key hits a 429 / RESOURCE_EXHAUSTED quota
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
LEONARDO_API_KEY=
BYTEPLUS_API_KEY=
# Fallback for BYTEPLUS_API_KEY (Volcengine ARK shared name)
ARK_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
ATLASCLOUD_API_KEY=
# Replicate (direct API; also used by Cloudflare AI Gateway video)
REPLICATE_API_TOKEN=
# Fallback for REPLICATE_API_TOKEN (direct `multix replicate` only; Cloudflare video reads REPLICATE_API_TOKEN)
REPLICATE_API_KEY=
# Runway API secret (Gen-4.5 / Gen-4 Turbo video, Gen-4 images)
RUNWAYML_API_SECRET=
# HeyGen API key (sent as X-Api-Key; API billing is separate from HeyGen web plans)
HEYGEN_API_KEY=

# ===== Output / CLI behavior =====
# Override default output dir (./multix-output)
MULTIX_OUTPUT_DIR=
# Size limit in MB per downloaded Replicate, Runway or Atlas Cloud output file (default 2048)
MULTIX_MAX_DOWNLOAD_MB=
# Slowest upload speed to allow for (Gemini Files API, Runway inline images), in KB/s (default 1000 = 1 MB/s)
MULTIX_UPLOAD_MIN_KBPS=
# Set to "1" to disable loading ~/.multix/.env
MULTIX_DISABLE_HOME_ENV=
# Set to "json" to print one multix.result/v1 envelope per run (same as --json)
MULTIX_OUTPUT=
# Set to "0" to stop recording runs in ~/.multix/history.jsonl
MULTIX_HISTORY=
# Run ledger path (shell or ~/.multix/.env only; refused in a project .env)
MULTIX_HISTORY_FILE=
# Set to "1" to disable ANSI colors
NO_COLOR=
# *_BASE_URL, CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_AI_GATEWAY_ID from a project
# .env are used only when the keys sent with them are in this same file.
# Otherwise ~/.multix/.env wins, or the command stops with an error. To use
# project values with keys from elsewhere for one command, run
# `MULTIX_ALLOW_PROJECT_BASE_URL=1 multix ...` in your shell. Setting it here is
# ignored; setting it in ~/.multix/.env disables the check for every directory.
# Non-default base URLs must be https:// (http:// only for localhost/127.0.0.1/[::1]).

# ===== Gemini model overrides =====
# The default text-output model for analyze, transcribe, extract, and doc convert is gemini-3.6-flash.
GEMINI_MODEL=
MULTIMODAL_MODEL=
IMAGE_GEN_MODEL=
GEMINI_IMAGE_GEN_MODEL=
# Video default: gemini-omni-1.1-flash (Gemini Omni Flash). veo-* selects the legacy Veo path;
# the Veo 3.1 preview models shut down on the Gemini API on 2026-10-22.
VIDEO_GEN_MODEL=
GEMINI_TTS_MODEL=
TTS_MODEL=

# ===== OpenRouter model overrides =====
OPENROUTER_IMAGE_MODEL=
OPENROUTER_VIDEO_MODEL=
# Comma-separated fallback model ids
OPENROUTER_FALLBACK_MODELS=

# ===== OpenAI model overrides =====
OPENAI_IMAGE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_STT_MODEL=

# ===== MiniMax model overrides =====
MINIMAX_IMAGE_MODEL=
MINIMAX_VIDEO_MODEL=
MINIMAX_SPEECH_MODEL=
MINIMAX_MUSIC_MODEL=

# ===== Leonardo model overrides =====
LEONARDO_DEFAULT_MODEL=
LEONARDO_VIDEO_MODEL=

# ===== BytePlus model overrides =====
BYTEPLUS_IMAGE_MODEL=
BYTEPLUS_VIDEO_MODEL=
BYTEPLUS_VIDEO_PARAMS_MODE=

# ===== fal.ai model overrides =====
FAL_BASE_URL=
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=
FAL_VIDEO_IMAGE_MODEL=
# Max size in MB for local files uploaded via `fal upload` / `fal run --file` (default 1024)
FAL_MAX_UPLOAD_MB=
# Also read legacy AgentKit .claude env files (off by default; shell or ~/.multix/.env only)
MULTIX_LEGACY_CLAUDE_ENV=

# ===== Atlas Cloud overrides =====
# Media API base (default https://api.atlascloud.ai/api/v1); for testing/mocks only.
# Must be https://; http:// is accepted only for localhost, 127.0.0.1 or [::1]
ATLASCLOUD_BASE_URL=
ATLASCLOUD_IMAGE_MODEL=
ATLASCLOUD_IMAGE_EDIT_MODEL=
ATLASCLOUD_VIDEO_MODEL=
ATLASCLOUD_IMAGE_TO_VIDEO_MODEL=
ATLASCLOUD_TTS_MODEL=
ATLASCLOUD_STT_MODEL=
ATLASCLOUD_TEXT_TO_3D_MODEL=
ATLASCLOUD_IMAGE_TO_3D_MODEL=
# Max size in MB for local files uploaded via --ref/--audio/upload (default 200)
ATLASCLOUD_MAX_UPLOAD_MB=

# ===== Replicate overrides =====
# API root override for mocks/proxies (default https://api.replicate.com/v1)
REPLICATE_BASE_URL=
# Defaults: black-forest-labs/flux-schnell and prunaai/p-video
REPLICATE_IMAGE_MODEL=
REPLICATE_VIDEO_MODEL=

# ===== Runway overrides =====
# API root override for mocks/proxies (default https://api.dev.runwayml.com)
RUNWAY_BASE_URL=
# Defaults: gen4_image and gen4.5 (supported: gen4_image, gen4_image_turbo; gen4.5, gen4_turbo)
RUNWAY_IMAGE_MODEL=
RUNWAY_VIDEO_MODEL=

# ===== HeyGen =====
# Override the API base URL (tests/proxies only; default https://api.heygen.com)
HEYGEN_BASE_URL=
