{
  "name": "multix-mcp-worker",
  "private": true,
  "type": "module",
  "description": "multix remote MCP server (Streamable HTTP) for Cloudflare Workers",
  "scripts": {
    "skills": "tsx scripts/build-skill-catalog.ts",
    "predev": "npm run skills",
    "dev": "wrangler dev --port 8787",
    "predeploy": "npm run skills",
    "deploy": "wrangler deploy",
    "prebuild": "npm run skills",
    "build": "wrangler deploy --dry-run --containers-rollout=none --outdir dist",
    "check:bundle": "npm run build && node scripts/check-bundle.mjs dist",
    "pretypecheck": "npm run skills",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run skills",
    "test": "vitest run",
    "catalog": "tsx scripts/build-cli-catalog.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/server": "2.3.1",
    "aws4fetch": "1.0.20",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
