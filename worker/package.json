{
  "name": "multix-mcp-worker",
  "private": true,
  "type": "module",
  "description": "multix remote MCP server (Streamable HTTP) for Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check:bundle": "npm run build && node scripts/check-bundle.mjs dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
