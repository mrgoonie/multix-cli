# multix-server environment (self-hosted). Copy to .env and fill in; never commit it.
# Required secrets
SESSION_SECRET=            # 32+ random characters: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=    # base64 of 32 random bytes: openssl rand -base64 32
# Public HTTPS origin users and MCP clients reach (http only for localhost)
MULTIX_PUBLIC_URL=https://multix.example.com
# Sign-in: local admin (bootstrap) and/or GitHub
MULTIX_LOCAL_AUTH=true
# MULTIX_BOOTSTRAP_TOKEN=  # optional, 32+ chars; otherwise a token is generated and printed at start
# GITHUB_CLIENT_ID=        # optional GitHub sign-in (callback: <origin>/oauth/github/callback)
# GITHUB_CLIENT_SECRET=
# MULTIX_ALLOWED_USERS=    # GitHub logins / verified emails allowed to sign in with GitHub
# Server
# PORT=3000
# MULTIX_DATA_DIR=/data
# MULTIX_TRUST_PROXY_HOPS=1   # behind one reverse proxy (TOSE ingress)
# MULTIX_SHUTDOWN_TIMEOUT_MS=20000
# Jobs (multix_run, /api/v1/jobs): run the multix CLI as child processes of this server.
# Off unless set. Outputs go to the account's R2/S3 bucket set in /dashboard; without one
# no file is kept. Run one replica per data volume (ReadWriteOnce).
MULTIX_LOCAL_JOBS=true
MULTIX_LOCAL_MAX_CONCURRENT_JOBS=1   # 1-64; also caps MULTIX_MAX_JOBS_TOTAL
# MULTIX_MAX_JOBS_PER_ACCOUNT=2
# Runs whose spend the operator caps cannot bound: deny (refuse), budget (need max_cost_usd), allow
MULTIX_MCP_UNCAPPED_SPEND=deny
# Kubernetes: run each job as its own Kubernetes Job instead of a child process.
# Apply worker/server/k8s/job-executor.yaml first; the server will not start without its NetworkPolicy.
# MULTIX_JOB_EXECUTOR=kubernetes
# MULTIX_K8S_JOB_IMAGE=ghcr.io/mrgoonie/multix-job:<version>   # same version as the server; for a release without it, build worker/container/Dockerfile
