// multix remote MCP server. Separate from docs-site/wrangler.jsonc (the docs site).
// Secrets are never stored here: set them with `npx wrangler secret put <NAME>`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multix-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // No nodejs_compat: the bundle must not depend on Node built-ins.
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    "MULTIX_MCP_MAX_OUTPUTS": "4",
    "MULTIX_MCP_MAX_VIDEO_SECONDS": "10"
  }
}
