{
  "name": "multix-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build && node scripts/write-security-headers.mjs",
    "check": "astro check",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm run test",
    "deploy": "npm run verify && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.8",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
