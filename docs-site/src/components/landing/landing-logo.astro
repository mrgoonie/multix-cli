  <g fill="currentColor" opacity=".38">
    <circle cx="3" cy="3" r="1.4"></circle><circle cx="11" cy="3" r="1.4"></circle>
    <circle cx="19" cy="3" r="1.4"></circle><circle cx="3" cy="11" r="1.4"></circle>
    <circle cx="19" cy="11" r="1.4"></circle><circle cx="3" cy="19" r="1.4"></circle>
    <circle cx="19" cy="19" r="1.4"></circle>
  </g>
  <circle class="mx-logo-core" cx="11" cy="11" r="2.6"></circle>
  <circle class="mx-logo-hear" cx="11" cy="19" r="1.8"></circle>
</svg>
